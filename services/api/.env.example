# OpenPass API — Cloudflare Worker environment
#
# HOW WORKERS HANDLE ENV (different from Node/Bun):
# - Production: plain vars live in wrangler.jsonc under "vars"; secrets are set with
#   `wrangler secret put <NAME>` (encrypted at rest, never in the repo).
# - Local dev (`wrangler dev`): copy THIS file to `.dev.vars` in this directory and
#   fill it in. `.dev.vars` is gitignored. Do not use a plain `.env` for the Worker.
# - Bindings (DB, ATTACHMENTS, RATE_LIMITER below) are NOT env vars — they are
#   provisioned resources declared in wrangler.jsonc. They are listed so you know
#   what the Worker expects to exist in your Cloudflare account.

# --- Plain variables (also settable in wrangler.jsonc "vars") ---

# Allow public account registration. Set to "false" after creating your own
# account to run a private instance. Any other value (or unset) = open.
ALLOW_REGISTRATION=true

# --- Secrets (production: `wrangler secret put <NAME>`) ---

# Reserved for a future peppered session-token scheme. Currently GENERATED by
# `bun run setup` but NOT read by the code (session tokens are SHA-256-hashed
# at rest). Safe to leave unset today.
SESSION_PEPPER=

# Cloudflare Turnstile secret key. Declared in the Worker env but not enforced
# yet (registration captcha is planned). Safe to leave unset.
TURNSTILE_SECRET=

# --- Bindings the Worker requires (wrangler.jsonc — NOT env vars) ---
# DB            D1 database   `wrangler d1 create openpass` (+ migrations)
# ATTACHMENTS   R2 bucket     `wrangler r2 bucket create openpass-attachments`
# RATE_LIMITER  Durable Object class RateLimiter (declared in wrangler.jsonc)
# `bun run setup` (scripts/setup.ts) creates/patches all of the above for you.

# --- Only needed for CI / non-interactive deploys ---
# Wrangler reads these automatically when present. For interactive use,
# `wrangler login` (browser) is enough and these stay unset.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
