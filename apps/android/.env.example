# OpenPass for Android — build-time environment
#
# Android apps cannot read .env files at runtime. The one configurable value
# (default API URL) is baked into BuildConfig at build time. Copy these into
# your shell before building, or pass -Popenpass.apiUrl to Gradle instead.
# No secrets belong here — the app holds no API keys by design.

# Default OpenPass API (Worker) URL compiled into the app.
# Priority: -Popenpass.apiUrl  >  OPENPASS_API_URL  >  http://10.0.2.2:8787
# (10.0.2.2 is the Android emulator's address for your host machine's localhost,
# which is where `bun run dev:api` listens.)
# For a physical device use your deployed Worker URL, e.g.:
#   OPENPASS_API_URL=https://openpass-api.your-subdomain.workers.dev
OPENPASS_API_URL=http://10.0.2.2:8787

# --- Toolchain locations (CLI builds only; Android Studio manages its own) ---
# JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
# ANDROID_HOME=/opt/homebrew/share/android-commandlinetools
# ANDROID_SDK_ROOT=/opt/homebrew/share/android-commandlinetools
#
# Build:
#   bash ../../scripts/build-android-core.sh   # Rust core -> jniLibs
#   ./gradlew assembleDebug
#
# Runtime configuration inside the app:
# - Email/password: entered on the lock screen, never stored.
# - Device ID: generated once in SharedPreferences ("openpass.deviceId").
# - Vault key: memory only; biometric copy wrapped by Android Keystore
#   (BiometricVaultKeyStore). local.properties (SDK path) is machine-local
#   and gitignored — never commit it.
