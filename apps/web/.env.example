# OpenPass Web Vault — Vite environment
#
# Usage: copy to `.env` in this directory (apps/web/.env), then `bun run dev` / `bun run build`.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Everything here is public by definition — never put secrets in a VITE_ variable.

# Default OpenPass API (Worker) URL used when the user has not configured a
# server in the vault UI. Priority at runtime:
#   1. server URL saved in the UI (localStorage "openpass.serverUrl")
#   2. VITE_SERVER_URL (this file, baked in at build time)
#   3. http://localhost:8787 (local API dev server)
# Examples:
#   VITE_SERVER_URL=https://openpass-api.your-subdomain.workers.dev
#   VITE_SERVER_URL=http://localhost:8787
VITE_SERVER_URL=http://localhost:8787
